---
import type { ProjectRecord } from "../content/schema/families.ts";

interface Props {
  claims: ProjectRecord["claims"];
  evidence: ProjectRecord["evidence"];
  sources: ProjectRecord["sources"];
  limitations: ProjectRecord["limitations"];
}

const { claims, evidence, sources, limitations } = Astro.props;
const evidenceById = new Map(
  evidence.map((item) => [item.evidenceId, item]),
);
const sourceById = new Map(sources.map((source) => [source.sourceId, source]));
const knownClaimIds = new Set(claims.map((claim) => claim.claimId));
const additionalLimitations = limitations.filter(
  (limitation) =>
    !limitation.claimIds?.some((claimId) => knownClaimIds.has(claimId)),
);

const formatState = (value: string) =>
  value
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
---

<section class="evidence-trace" aria-labelledby="evidence-trace-title">
  <div class="evidence-trace__heading">
    <p class="context-label">Claim, support, and boundary</p>
    <h2 id="evidence-trace-title">Evidence Trace</h2>
    <p>
      Each public claim is shown with its review basis and the limitation that
      constrains it.
    </p>
  </div>

  <div class="evidence-trace__claims">
    {
      claims.map((claim, index) => {
        const claimEvidence = (claim.evidenceRefs ?? [])
          .map((reference) => evidenceById.get(reference.evidenceId))
          .filter((item): item is ProjectRecord["evidence"][number] =>
            Boolean(item),
          );
        const claimSourceIds = new Set(
          claimEvidence.flatMap((item) => item.sourceIds ?? []),
        );
        const claimSources = [...claimSourceIds]
          .map((sourceId) => sourceById.get(sourceId))
          .filter((source): source is ProjectRecord["sources"][number] =>
            Boolean(source),
          );
        const claimLimitations = limitations.filter((limitation) =>
          limitation.claimIds?.includes(claim.claimId),
        );
        const claimTitleId = `evidence-claim-${index + 1}`;

        return (
          <article class="evidence-claim" aria-labelledby={claimTitleId}>
            <header>
              <p class="evidence-claim__number">
                Claim {String(index + 1).padStart(2, "0")}
              </p>
              <h3 id={claimTitleId}>{claim.statement}</h3>
            </header>

            <dl class="evidence-claim__state">
              <div>
                <dt>Claim state</dt>
                <dd>{formatState(claim.state)}</dd>
              </div>
              <div>
                <dt>Verification</dt>
                <dd>{formatState(claim.verification)}</dd>
              </div>
            </dl>

            <section aria-labelledby={`${claimTitleId}-evidence`}>
              <h4 id={`${claimTitleId}-evidence`}>Evidence</h4>
              <ul class="evidence-list">
                {
                  claimEvidence.map((item) => (
                    <li>
                      <strong>{item.title}</strong>
                      <p>{item.purpose}</p>
                      <p>{item.scope}</p>
                      <dl>
                        <div>
                          <dt>Availability</dt>
                          <dd>{formatState(item.availability)}</dd>
                        </div>
                        <div>
                          <dt>Verification</dt>
                          <dd>{formatState(item.verification)}</dd>
                        </div>
                      </dl>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section aria-labelledby={`${claimTitleId}-sources`}>
              <h4 id={`${claimTitleId}-sources`}>Sources</h4>
              <ul class="source-list">
                {
                  claimSources.map((source) => (
                    <li>
                      <strong>{source.title}</strong>
                      <span>{formatState(source.availability)}</span>
                      {source.limitation && <p>{source.limitation}</p>}
                    </li>
                  ))
                }
              </ul>
            </section>

            {
              claimLimitations.length > 0 && (
                <section
                  class="claim-limitations"
                  aria-labelledby={`${claimTitleId}-limitations`}
                >
                  <h4 id={`${claimTitleId}-limitations`}>Limitations</h4>
                  <ul>
                    {claimLimitations.map((limitation) => (
                      <li>{limitation.statement}</li>
                    ))}
                  </ul>
                </section>
              )
            }
          </article>
        );
      })
    }
  </div>

  {
    additionalLimitations.length > 0 && (
      <section
        class="additional-limitations"
        aria-labelledby="additional-limitations-title"
      >
        <h3 id="additional-limitations-title">Additional limitations</h3>
        <ul>
          {additionalLimitations.map((limitation) => (
            <li>{limitation.statement}</li>
          ))}
        </ul>
      </section>
    )
  }
</section>

<style>
  .evidence-trace {
    display: grid;
    gap: var(--space-section);
    margin-block-start: var(--space-major);
  }

  .evidence-trace__heading {
    max-width: var(--measure-reading);
  }

  .evidence-trace__heading > * {
    margin-block: 0;
  }

  .evidence-trace__heading > * + * {
    margin-block-start: var(--space-content);
  }

  .evidence-trace__claims {
    display: grid;
    gap: var(--space-component);
  }

  .evidence-claim {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-inline-start: 0.3rem solid var(--color-accent);
    border-radius: var(--radius-surface);
    background: var(--color-evidence-surface);
  }

  .evidence-claim > * {
    margin-block: 0;
  }

  .evidence-claim > * + * {
    margin-block-start: var(--space-component);
  }

  .evidence-claim h3 {
    max-width: var(--measure-reading);
    font-size: var(--step-2);
  }

  .evidence-claim h4 {
    margin-block: 0 0.75rem;
    font-size: var(--step-0);
  }

  .evidence-claim__number {
    margin: 0 0 0.65rem;
    color: var(--color-secondary-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .evidence-claim__state,
  .evidence-list dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-content);
    margin: 0;
  }

  .evidence-claim__state div,
  .evidence-list dl div {
    min-width: 0;
  }

  .evidence-claim dt,
  .evidence-list dt {
    color: var(--color-secondary-text);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .evidence-claim dd,
  .evidence-list dd {
    margin: 0.2rem 0 0;
  }

  .evidence-list,
  .source-list,
  .claim-limitations ul,
  .additional-limitations ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }

  .evidence-list li + li,
  .source-list li + li {
    margin-block-start: var(--space-content);
  }

  .evidence-list p {
    max-width: var(--measure-reading);
    margin-block: 0.45rem;
  }

  .source-list span {
    display: block;
    color: var(--color-secondary-text);
    font-size: var(--step--1);
  }

  .claim-limitations,
  .additional-limitations {
    padding: var(--space-component);
    border: 1px solid var(--color-strong-border);
    border-radius: var(--radius-surface);
    background: var(--color-limitation-surface);
  }

  .additional-limitations h3 {
    margin-block-start: 0;
  }

  @media (min-width: 54rem) {
    .evidence-trace__claims {
      grid-template-columns: minmax(0, 1fr);
    }

    .evidence-claim {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr);
      column-gap: var(--space-section);
    }

    .evidence-claim > header,
    .evidence-claim > .evidence-claim__state {
      grid-column: 1;
    }

    .evidence-claim > section {
      grid-column: 2;
    }

    .evidence-claim > .claim-limitations {
      grid-column: 1 / -1;
    }
  }
</style>
