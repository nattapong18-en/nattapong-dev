---
import type { ProjectRecord } from "../content/schema/families.ts";

interface Props {
  claims: ProjectRecord["claims"];
  evidence: ProjectRecord["evidence"];
  sources: ProjectRecord["sources"];
  limitations: ProjectRecord["limitations"];
}

const { claims, evidence, sources, limitations } = Astro.props;
const evidenceById = new Map(
  evidence.map((item) => [item.evidenceId, item]),
);
const sourceById = new Map(sources.map((source) => [source.sourceId, source]));
const knownClaimIds = new Set(claims.map((claim) => claim.claimId));
const additionalLimitations = limitations.filter(
  (limitation) =>
    !limitation.claimIds?.some((claimId) => knownClaimIds.has(claimId)),
);

type Claim = ProjectRecord["claims"][number];
type Evidence = ProjectRecord["evidence"][number];
type Source = ProjectRecord["sources"][number];
type Limitation = ProjectRecord["limitations"][number];

interface ResolvedClaim {
  claim: Claim;
  label: string;
  titleId: string;
}

interface SupportGroup {
  claims: ResolvedClaim[];
  evidence: Evidence[];
  sources: Source[];
  limitations: Limitation[];
}

const formatState = (value: string) =>
  value
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");

const resolvedClaims: ResolvedClaim[] = claims.map((claim, index) => ({
  claim,
  label: `Claim ${String(index + 1).padStart(2, "0")}`,
  titleId: `evidence-claim-${index + 1}`,
}));

const supportGroupsByRelationship = new Map<string, SupportGroup>();

for (const resolvedClaim of resolvedClaims) {
  const evidenceReferences = resolvedClaim.claim.evidenceRefs ?? [];
  const claimEvidence = evidenceReferences
    .map((reference) => evidenceById.get(reference.evidenceId))
    .filter((item): item is Evidence => Boolean(item));
  const claimSourceIds = [
    ...new Set(claimEvidence.flatMap((item) => item.sourceIds ?? [])),
  ];
  const claimSources = claimSourceIds
    .map((sourceId) => sourceById.get(sourceId))
    .filter((source): source is Source => Boolean(source));
  const claimLimitations = limitations.filter((limitation) =>
    limitation.claimIds?.includes(resolvedClaim.claim.claimId),
  );

  const normalizedEvidenceReferences = evidenceReferences
    .map((reference) => ({
      evidenceId: reference.evidenceId,
      requirement: reference.requirement,
    }))
    .sort((first, second) =>
      `${first.evidenceId}:${first.requirement}`.localeCompare(
        `${second.evidenceId}:${second.requirement}`,
      ),
    );
  const normalizedEvidence = claimEvidence
    .map((item) => ({
      evidenceId: item.evidenceId,
      verification: item.verification,
      sourceIds: [...(item.sourceIds ?? [])].sort(),
    }))
    .sort((first, second) =>
      first.evidenceId.localeCompare(second.evidenceId),
    );

  const relationshipKey = JSON.stringify({
    evidenceReferences: normalizedEvidenceReferences,
    evidence: normalizedEvidence,
    sourceIds: claimSources.map((source) => source.sourceId).sort(),
    limitationIds: claimLimitations
      .map((limitation) => limitation.limitationId)
      .sort(),
  });
  const existingGroup = supportGroupsByRelationship.get(relationshipKey);

  if (existingGroup) {
    existingGroup.claims.push(resolvedClaim);
  } else {
    supportGroupsByRelationship.set(relationshipKey, {
      claims: [resolvedClaim],
      evidence: claimEvidence,
      sources: claimSources,
      limitations: claimLimitations,
    });
  }
}

const supportGroups = [...supportGroupsByRelationship.values()];
---

<section class="evidence-trace" aria-labelledby="evidence-trace-title">
  <div class="evidence-trace__heading">
    <p class="context-label">Claim, support, and boundary</p>
    <h2 id="evidence-trace-title">Evidence Trace</h2>
    <p>
      Each public claim is shown with its review basis and the limitation that
      constrains it.
    </p>
  </div>

  <div class="evidence-trace__claims">
    {
      resolvedClaims.map(({ claim, label, titleId }) => (
        <article class="evidence-claim" aria-labelledby={titleId}>
          <header>
            <p class="evidence-claim__number">{label}</p>
            <h3 id={titleId}>{claim.statement}</h3>
          </header>

          <dl class="evidence-claim__state">
            <div>
              <dt>Claim state</dt>
              <dd>{formatState(claim.state)}</dd>
            </div>
            <div>
              <dt>Verification</dt>
              <dd>{formatState(claim.verification)}</dd>
            </div>
          </dl>
        </article>
      ))
    }
  </div>

  <div class="evidence-trace__support">
    {
      supportGroups.map((group, groupIndex) => {
        const supportId = `evidence-support-${groupIndex + 1}`;
        const isShared = group.claims.length > 1;

        return (
          <section
            class="evidence-support"
            aria-labelledby={`${supportId}-title`}
          >
            <header>
              <p class="context-label">
                {isShared ? "Shared support" : "Claim support"}
              </p>
              <h3 id={`${supportId}-title`}>
                {isShared
                  ? `Shared review basis ${String(groupIndex + 1).padStart(2, "0")}`
                  : `Review basis for ${group.claims[0].label}`}
              </h3>
            </header>

            <div class="evidence-support__applies">
              <h4>Applies to</h4>
              <ul>
                {group.claims.map(({ claim, label, titleId }) => (
                  <li>
                    <a href={`#${titleId}`}>
                      <span>{label}:</span> {claim.statement}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <section aria-labelledby={`${supportId}-evidence`}>
              <h4 id={`${supportId}-evidence`}>Evidence</h4>
              <ul class="evidence-list">
                {group.evidence.map((item) => (
                  <li>
                    <strong>{item.title}</strong>
                    <p>{item.purpose}</p>
                    <p>{item.scope}</p>
                    <dl>
                      <div>
                        <dt>Availability</dt>
                        <dd>{formatState(item.availability)}</dd>
                      </div>
                      <div>
                        <dt>Verification</dt>
                        <dd>{formatState(item.verification)}</dd>
                      </div>
                    </dl>
                  </li>
                ))}
              </ul>
            </section>

            <section aria-labelledby={`${supportId}-sources`}>
              <h4 id={`${supportId}-sources`}>Sources</h4>
              <ul class="source-list">
                {group.sources.map((source) => (
                  <li>
                    <strong>{source.title}</strong>
                    <span>{formatState(source.availability)}</span>
                    {source.locator && <p>{source.locator}</p>}
                    {source.limitation && <p>{source.limitation}</p>}
                  </li>
                ))}
              </ul>
            </section>

            {
              group.limitations.length > 0 && (
                <section
                  class="claim-limitations"
                  aria-labelledby={`${supportId}-limitations`}
                >
                  <h4 id={`${supportId}-limitations`}>Limitations</h4>
                  <ul>
                    {group.limitations.map((limitation) => (
                      <li>{limitation.statement}</li>
                    ))}
                  </ul>
                </section>
              )
            }
          </section>
        );
      })
    }
  </div>

  {
    additionalLimitations.length > 0 && (
      <section
        class="additional-limitations"
        aria-labelledby="additional-limitations-title"
      >
        <h3 id="additional-limitations-title">Additional limitations</h3>
        <ul>
          {additionalLimitations.map((limitation) => (
            <li>{limitation.statement}</li>
          ))}
        </ul>
      </section>
    )
  }
</section>

<style>
  .evidence-trace {
    display: grid;
    gap: var(--space-section);
    margin-block-start: var(--space-major);
  }

  .evidence-trace__heading {
    max-width: var(--measure-reading);
  }

  .evidence-trace__heading > * {
    margin-block: 0;
  }

  .evidence-trace__heading > * + * {
    margin-block-start: var(--space-content);
  }

  .evidence-trace__claims {
    display: grid;
    border-block-start: 1px solid var(--color-border);
  }

  .evidence-claim {
    display: grid;
    gap: var(--space-component);
    padding-block: var(--space-component);
    padding-inline: clamp(0.75rem, 2vw, 1.25rem);
    border-block-end: 1px solid var(--color-border);
    border-inline-start: 0.18rem solid transparent;
    scroll-margin-block-start: 1rem;
    transition:
      background-color 180ms var(--easing-feedback),
      border-color 180ms var(--easing-feedback);
  }

  .evidence-claim:target {
    border-inline-start-color: var(--color-accent);
    background: var(--color-evidence-surface);
  }

  .evidence-claim > * {
    margin-block: 0;
  }

  .evidence-claim h3 {
    max-width: var(--measure-reading);
    font-size: var(--step-1);
  }

  .evidence-claim__number {
    margin: 0 0 0.65rem;
    color: var(--color-accent);
    font-family: var(--font-technical);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }

  .evidence-claim__state {
    align-content: start;
  }

  .evidence-claim__state,
  .evidence-list dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-content);
    margin: 0;
  }

  .evidence-claim__state div,
  .evidence-list dl div {
    min-width: 0;
  }

  .evidence-claim dt,
  .evidence-list dt {
    color: var(--color-text-secondary);
    font-family: var(--font-metadata);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .evidence-claim dt {
    color: var(--color-accent);
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .evidence-claim dd,
  .evidence-list dd {
    margin: 0.2rem 0 0;
  }

  .evidence-trace__support {
    display: grid;
    gap: var(--space-component);
  }

  .evidence-support {
    display: grid;
    gap: var(--space-component);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-inline-start: 0.3rem solid var(--color-accent);
    border-radius: var(--radius-surface);
    background: var(--color-evidence-surface);
  }

  .evidence-support > *,
  .evidence-support header > * {
    margin-block: 0;
  }

  .evidence-support header > * + * {
    margin-block-start: 0.65rem;
  }

  .evidence-support h3 {
    font-size: var(--step-2);
  }

  .evidence-support h4 {
    margin-block: 0 0.75rem;
    color: var(--color-accent);
    font-size: var(--step-0);
  }

  .evidence-support__applies ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-support__applies a {
    display: inline-block;
  }

  .evidence-support__applies span {
    font-family: var(--font-technical);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .evidence-list,
  .source-list,
  .claim-limitations ul,
  .additional-limitations ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }

  .evidence-list li + li,
  .source-list li + li {
    margin-block-start: var(--space-content);
  }

  .evidence-list p {
    max-width: var(--measure-reading);
    margin-block: 0.45rem;
  }

  .source-list span {
    display: block;
    color: var(--color-text-secondary);
    font-family: var(--font-metadata);
    font-size: var(--step--1);
  }

  .claim-limitations,
  .additional-limitations {
    padding: var(--space-component);
    border: 1px solid var(--color-border);
    border-inline-start: 0.25rem solid var(--color-limitation-border);
    border-radius: var(--radius-surface);
    background: var(--color-limitation-surface);
    color: var(--color-limitation-text);
  }

  .claim-limitations h4,
  .additional-limitations h3 {
    color: var(--color-limitation-text);
  }

  .additional-limitations h3 {
    margin-block-start: 0;
  }

  @media (min-width: 54rem) {
    .evidence-claim {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
      column-gap: var(--space-section);
    }

    .evidence-support {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr);
      column-gap: var(--space-section);
    }

    .evidence-support > header,
    .evidence-support > .evidence-support__applies {
      grid-column: 1;
    }

    .evidence-support > section {
      grid-column: 2;
    }

    .evidence-support > .claim-limitations {
      grid-column: 1 / -1;
    }
  }
</style>
