---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicContent } from "../lib/public-content.ts";

const { about } = await getPublicContent();
const boundary = about.data.limitations?.[0];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "nattapong.dev",
    url: "https://nattapong.dev/",
    description: about.data.summary,
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Nattapong Sangsana",
    url: "https://nattapong.dev/",
    jobTitle: "Computer Engineering Student",
    affiliation: {
      "@type": "CollegeOrUniversity",
      name: "Nakhon Phanom University",
    },
    homeLocation: {
      "@type": "Country",
      name: "Thailand",
    },
    sameAs: ["https://github.com/nattapong18-en"],
  },
];
---

<BaseLayout
  title={`${about.data.title} — Nattapong Sangsana`}
  description={about.data.summary}
  currentPath="/"
  structuredData={structuredData}
>
  <div class="page-shell">
    <header class="page-intro">
      <p class="context-label">Computer Engineering Student</p>
      <h1>{about.data.title}</h1>
      <p class="lede">{about.data.summary}</p>
    </header>

    <div class="orientation-grid">
      <section aria-labelledby="engineering-direction-title">
        <h2 id="engineering-direction-title">Engineering direction</h2>
        <p>{about.data.direction}</p>
        <ul class="interest-list" aria-label="Learning directions">
          {about.data.interests.map((interest) => <li>{interest}</li>)}
        </ul>
      </section>

      <section aria-labelledby="public-record-title">
        <h2 id="public-record-title">Public record</h2>
        <ul class="scope-list">
          <li>Projects</li>
          <li>Research</li>
          <li>Learning</li>
        </ul>
        <a class="primary-link" href="/projects/">View projects</a>
      </section>
    </div>

    {
      boundary && (
        <aside
          class="limitation-note home-boundary"
          aria-labelledby="current-boundary-title"
        >
          <h2 id="current-boundary-title">Current boundary</h2>
          <p>{boundary.statement}</p>
        </aside>
      )
    }

    <footer class="home-footer" aria-label="Contact">
      <div class="home-footer__identity">
        <p class="home-footer__name">Nattapong Sangsana</p>
        <p>Computer Engineering Student</p>
      </div>
      <dl class="home-footer__links">
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:zpoloa0@gmail.com">zpoloa0@gmail.com</a></dd>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd>
            <a href="https://github.com/nattapong18-en">nattapong18-en</a>
          </dd>
        </div>
      </dl>
      <p class="home-footer__copyright">© 2026 nattapong.dev</p>
    </footer>
  </div>
</BaseLayout>
